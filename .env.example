# RecoverIQ - Razorpay Test-Mode Environment Configuration
# NEVER COMMIT REAL OR PRODUCTION CREDENTIALS

# Strictly enforced: Must be 'test'. Any other value will fail closed.
RAZORPAY_ENVIRONMENT=test

# Razorpay Test-Mode API Credentials (starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret

# Razorpay Webhook Secret for HMAC-SHA256 verification
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Server / Webhook Port
PORT=8000
